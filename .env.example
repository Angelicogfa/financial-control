# Copy this file to .env and customize values for your local environment.
# NEVER commit .env to version control.

POSTGRES_USER=fincontrol
POSTGRES_PASSWORD=fincontrol
POSTGRES_DB=fincontrol
POSTGRES_PORT=55432

REDIS_PORT=56379

DATABASE_URL=postgresql+psycopg://fincontrol:fincontrol@postgres:5432/fincontrol
REDIS_URL=redis://redis:6379/0

# brapi.dev API token (https://brapi.dev/dashboard).
# When empty, B3 requests automatically fall back to Yahoo Finance (.SA).
BRAPI_TOKEN=

# Central Bank of Brazil (BCB SGS) base URL for CDI (12), SELIC (11), and IPCA (433) series
BCB_SGS_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs

# Default annual risk-free rate (fraction) used as fallback when BCB SGS is unreachable (e.g. 0.1075 = 10.75% p.a.)
RISK_FREE_RATE=0.1075
DEFAULT_ANNUAL_IPCA=0.045

# Cache TTLs (seconds)
QUOTE_CACHE_TTL=300
FUNDAMENTALS_CACHE_TTL=86400
HISTORY_CACHE_TTL=21600

# Worker schedule configuration
QUOTE_REFRESH_MINUTES=15
SNAPSHOT_CRON_HOUR=18
SNAPSHOT_CRON_MINUTE=30
TZ=America/Sao_Paulo

# API & Web configuration
API_PORT=8000
WEB_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
