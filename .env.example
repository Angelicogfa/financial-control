# Copy this file to .env and customize values for your local environment.
# NEVER commit .env to version control. Every variable below is read either by
# fincontrol_config.Settings (API and worker) or by docker-compose.yml only.

# --- Runtime --------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# json (structured, one object per line) or text
LOG_FORMAT=json
TZ=America/Sao_Paulo

# --- Docker Compose only: database and cache containers -------------------
POSTGRES_USER=fincontrol
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=fincontrol
# Host ports below are used only by docker-compose.dev.yml (bound to 127.0.0.1)
POSTGRES_PORT=55432
REDIS_PASSWORD=change-me-redis
REDIS_PORT=56379
# Named Docker volumes holding the data (keep the defaults unless running a second stack)
PGDATA_VOLUME=fincontrol_pgdata
REDISDATA_VOLUME=fincontrol_redisdata
# Env file loaded into the app containers (another file lets a second stack run isolated)
APP_ENV_FILE=.env

# --- Storage (must match the credentials above) ----------------------------
DATABASE_URL=postgresql+psycopg://fincontrol:change-me-postgres@postgres:5432/fincontrol
REDIS_URL=redis://:change-me-redis@redis:6379/0

# --- Market data providers --------------------------------------------------
# brapi.dev API token (https://brapi.dev/dashboard).
# When empty, B3 requests automatically fall back to Yahoo Finance (.SA).
BRAPI_TOKEN=
# Base URL of the BCB SGS API; series are requested at <base>/bcdata.sgs.<code>/dados
BCB_SGS_BASE_URL=https://api.bcb.gov.br/dados/serie
# Parallel provider requests per portfolio valuation and overall timeout (seconds)
MARKET_FETCH_WORKERS=8
MARKET_FETCH_TIMEOUT_SECONDS=20

# --- Fallbacks when providers are unreachable (annual fractions, ADR 0006) --
RISK_FREE_RATE=0.1075
DEFAULT_ANNUAL_IPCA=0.045
DEFAULT_USD_BRL=5.15

# --- Cache TTLs (seconds) -----------------------------------------------------
QUOTE_CACHE_TTL=300
FUNDAMENTALS_CACHE_TTL=86400
HISTORY_CACHE_TTL=21600

# --- Worker schedule and resilience -----------------------------------------
QUOTE_REFRESH_MINUTES=15
BCB_SYNC_CRON_HOUR=18
BCB_SYNC_CRON_MINUTE=0
SNAPSHOT_CRON_HOUR=18
SNAPSHOT_CRON_MINUTE=30
# Weekly refresh of yearly statements (holdings and watchlist)
FUNDAMENTALS_CRON_DAY_OF_WEEK=sun
FUNDAMENTALS_CRON_HOUR=6
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_SECONDS=30
JOB_LOCK_TTL_SECONDS=3600

# --- API & Web ---------------------------------------------------------------
API_PORT=8000
WEB_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Single-user authentication ----------------------------------------------
# Generate the password hash with:
#   docker compose run --rm --no-deps api python -m fincontrol_api.auth hash-password
# Generate the JWT secret with:
#   docker compose run --rm --no-deps api python -m fincontrol_api.auth new-secret
# Values starting with "change-me" are treated as not configured and login is refused.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=change-me
AUTH_JWT_SECRET=change-me
AUTH_TOKEN_TTL_MINUTES=720
# Set to true when the web app is served over HTTPS
AUTH_COOKIE_SECURE=false
