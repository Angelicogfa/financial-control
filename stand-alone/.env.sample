# Financial Control - stand-alone stack.
# Copy this file to .env next to docker-compose.yml and replace every "change-me" value.
# NEVER share or commit .env. See README.md for the step-by-step guide.

# --- Version -----------------------------------------------------------------
# Release tag of the images to run (vX.Y.Z). "latest" follows the newest release;
# pin a tag to upgrade only when you choose.
FINCONTROL_VERSION=latest

# --- Runtime -----------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
# json (structured, one object per line) or text
LOG_FORMAT=json
TZ=America/Sao_Paulo

# --- Database and cache ------------------------------------------------------
# Use letters and digits only: the passwords are also placed inside connection URLs.
# Generate one with: openssl rand -hex 24
POSTGRES_USER=fincontrol
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=fincontrol
REDIS_PASSWORD=change-me-redis
# Named Docker volumes holding the data (keep the defaults unless running a second stack)
PGDATA_VOLUME=fincontrol_pgdata
REDISDATA_VOLUME=fincontrol_redisdata

# --- Web access --------------------------------------------------------------
# Port and interface where the app is published (127.0.0.1 = only this computer)
WEB_PORT=8080
WEB_BIND=0.0.0.0
# Addresses the browser uses to open the app (comma separated)
CORS_ORIGINS=http://localhost:8080

# --- Single-user authentication ----------------------------------------------
# Generate the hash (keep the single quotes):
#   docker compose run --rm --no-deps api python cli.py hash-password
# Generate the JWT secret:
#   docker compose run --rm --no-deps api python cli.py new-secret
# Values starting with "change-me" are treated as not configured and login is refused.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=change-me
AUTH_JWT_SECRET=change-me
AUTH_TOKEN_TTL_MINUTES=720
# Set to true when the app is served over HTTPS (reverse proxy with a certificate)
AUTH_COOKIE_SECURE=false

# --- Market data providers ---------------------------------------------------
# brapi.dev API token (https://brapi.dev/dashboard). Optional but recommended:
# when empty, B3 requests fall back to Yahoo Finance (.SA).
BRAPI_TOKEN=
# Longest history range the brapi plan accepts (free plan: 3mo; empty = no limit)
BRAPI_MAX_HISTORY_RANGE=3mo
# Simultaneous brapi requests allowed by the plan (free plan: 1)
BRAPI_MAX_CONCURRENCY=1
BCB_SGS_BASE_URL=https://api.bcb.gov.br/dados/serie
TESOURO_TRANSPARENTE_CSV_URL=https://www.tesourodireto.com.br/documents/d/guest/rendimento-investir-csv?download=true
TESOURO_HISTORY_CSV_URL=https://www.tesourotransparente.gov.br/ckan/dataset/df56aa42-484a-4a59-8184-7676580c81e3/resource/796d2059-14e9-44e3-80c9-2d9e30b405c1/download/PrecoTaxaTesouroDireto.csv
CVM_OPEN_DATA_BASE_URL=https://dados.cvm.gov.br/dados
# Parallel provider requests per portfolio valuation and overall timeout (seconds)
MARKET_FETCH_WORKERS=8
MARKET_FETCH_TIMEOUT_SECONDS=20

# --- Fallbacks when providers are unreachable (annual fractions) -------------
RISK_FREE_RATE=0.1075
DEFAULT_ANNUAL_IPCA=0.045
DEFAULT_USD_BRL=5.15

# --- Cache TTLs (seconds) ----------------------------------------------------
QUOTE_CACHE_TTL=300
FUNDAMENTALS_CACHE_TTL=86400
HISTORY_CACHE_TTL=21600
MARKET_MISS_CACHE_TTL=300

# --- Worker schedule and resilience ------------------------------------------
QUOTE_REFRESH_MINUTES=5
WATCHLIST_REFRESH_MINUTES=60
DISTRIBUTIONS_REFRESH_HOURS=6
BCB_SYNC_CRON_HOUR=18
BCB_SYNC_CRON_MINUTE=0
SNAPSHOT_CRON_HOUR=18
SNAPSHOT_CRON_MINUTE=30
FUNDAMENTALS_CRON_DAY_OF_WEEK=sun
FUNDAMENTALS_CRON_HOUR=6
CATALOG_SYNC_CRON_HOUR=19
CVM_SYNC_CRON_HOUR=7
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_SECONDS=30
JOB_LOCK_TTL_SECONDS=3600

# --- Simulation --------------------------------------------------------------
SIMULATION_CATALOG_TOP=50
SIMULATION_TIMEOUT_SECONDS=120
SIMULATION_POLL_SECONDS=15
